# GhostNet Environment Configuration

# Nansen API Key (required for core functionality)
NANSEN_API_KEY=your_nansen_api_key_here

# Telegram Bot Configuration (optional - for monitoring alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Server Configuration
PORT=3000

# ══════════════════════════════════════════════════════════════
# ProofAlpha (0G) Configuration
# ══════════════════════════════════════════════════════════════

# 0G Chain RPC endpoints
# Testnet (Galileo): https://evmrpc-testnet.0g.ai
# Mainnet: https://evmrpc.0g.ai
ZG_RPC_URL=https://evmrpc-testnet.0g.ai

# 0G Storage endpoints
ZG_STORAGE_ENDPOINT=https://rpc-storage-testnet.0g.ai

# Private key of the wallet that will submit proofs
# ⚠️  NEVER commit this to version control!
DEPLOYER_PRIVATE_KEY=

# CoordinationRegistry contract address (set after deployment)
COORDINATION_REGISTRY_ADDRESS=

# Use mainnet (true) or testnet (false)
ZG_MAINNET=false

# ══════════════════════════════════════════════════════════════
# Setup Instructions for ProofAlpha
# ══════════════════════════════════════════════════════════════

# 1. Get testnet tokens: https://faucet.0g.ai
# 2. Add your DEPLOYER_PRIVATE_KEY above
# 3. Run: npm run deploy:contract
# 4. Copy contract address to COORDINATION_REGISTRY_ADDRESS above
# 5. Start watcher: npm start
# 6. Coordination clusters will be auto-submitted to 0G!
